{
  "name": "agent-html-collab",
  "version": "0.3.0",
  "type": "module",
  "description": "通用 HTML 原型人机协同插件:就地改字 / 移动元素 / 标注提意见 / 反馈回灌任意编码 agent",
  "bin": {
    "agent-html-collab": "bin/agent-html-collab.mjs"
  },
  "files": [
    "bin",
    "packages",
    "studio",
    "skills",
    "adapters",
    "examples",
    "AGENTS-SNIPPET.md",
    "SPEC.md",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    ".zcode-plugin",
    ".mcp.json",
    "marketplace.json"
  ],
  "scripts": {
    "serve": "node studio/serve.mjs",
    "apply": "node studio/apply.mjs",
    "init": "node studio/init.mjs",
    "verify": "node tests/verify-generic.mjs",
    "verify:single": "node tests/verify-single.mjs",
    "verify:multi": "node tests/verify-multi.mjs",
    "verify:move": "node tests/verify-move.mjs",
    "verify:opencode": "node tests/verify-opencode-v2.mjs",
    "verify:storage": "node tests/verify-storage.mjs",
    "test": "node --test tests/host-bridge.test.mjs tests/dsh-plugin.test.mjs tests/zcode-plugin.test.mjs tests/opencode-plugin.test.mjs tests/apply.test.mjs tests/storage.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noctide/agent-html-collab.git"
  },
  "exports": {
    ".": "./packages/dsh-plugin/index.mjs",
    "./client": "./packages/dsh-plugin/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./packages/dsh-plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "html-prototype",
    "prototype",
    "annotation",
    "feedback",
    "agent",
    "opencode",
    "wireframe",
    "studio"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
